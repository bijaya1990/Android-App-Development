<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Header ===== -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_rounded"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="10dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_round12">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/app_logo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.OnBrand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"
                            android:text="@string/namaste"
                            android:textSize="12sp" />

                        <TextView
                            style="@style/Text.OnBrand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/jakarta_800"
                            android:text="@string/tagline"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnTheme"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_glass"
                        android:contentDescription="@string/theme"
                        android:src="@drawable/ic_dark_mode"
                        app:tint="@color/on_brand" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_search"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/brand_700" />

                    <TextView
                        style="@style/Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/search_hint"
                        android:textColor="@color/text_3"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_round12"
                        android:backgroundTint="@color/brand_100"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/brand_700" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:id="@+id/stat1"
                        style="@style/StatBox"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/stat1Value"
                            style="@style/StatValue"
                            tools:text="1,097" />

                        <TextView
                            android:id="@+id/stat1Label"
                            style="@style/StatLabel"
                            android:text="@string/stat_active" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/stat2"
                        style="@style/StatBox"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/stat2Value"
                            style="@style/StatValue"
                            android:textColor="#7CFFB2"
                            tools:text="189" />

                        <TextView
                            android:id="@+id/stat2Label"
                            style="@style/StatLabel"
                            tools:text="In Odisha" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/stat3"
                        style="@style/StatBox">

                        <TextView
                            android:id="@+id/stat3Value"
                            style="@style/StatValue"
                            android:textColor="#FFC58A"
                            tools:text="18" />

                        <TextView
                            android:id="@+id/stat3Label"
                            style="@style/StatLabel"
                            android:text="@string/stat_usa" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Categories ===== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- ===== For You ===== -->
            <LinearLayout
                android:id="@+id/forYouHeader"
                style="@style/SectionHeader">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/for_you" />

                <TextView
                    android:id="@+id/forYouSub"
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="· Graduate · Odisha" />

                <TextView
                    android:id="@+id/forYouAll"
                    style="@style/Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:text="@string/see_all" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/forYouList"
                android:layout_width="match_parent"
                android:layout_height="178dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/gutter"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Shown instead of For You until a qualification is chosen. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/setupCard"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/gutter"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/brand_50"
                app:strokeColor="@color/brand_100">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_round12"
                        android:backgroundTint="@color/brand_700"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_person_search"
                        app:tint="@color/on_brand" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_qualification_title" />

                        <TextView
                            style="@style/Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/set_qualification_body"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSetup"
                        style="@style/Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/set_now" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Banner ad ===== -->
            <FrameLayout
                android:id="@+id/bannerAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="50dp"
                android:visibility="gone" />

            <!-- ===== Closing soon ===== -->
            <LinearLayout
                android:id="@+id/closingHeader"
                style="@style/SectionHeader"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:text="@string/closing_soon"
                    app:drawableStartCompat="@drawable/ic_schedule"
                    app:drawableTint="@color/accent" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/closingList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/gutter"
                android:visibility="gone" />

            <!-- ===== Latest ===== -->
            <LinearLayout style="@style/SectionHeader">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:text="@string/latest_jobs"
                    app:drawableStartCompat="@drawable/ic_local_fire_department"
                    app:drawableTint="@color/red" />

                <TextView
                    android:id="@+id/latestAll"
                    style="@style/Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:text="@string/see_all" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/latestList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/gutter" />

            <include
                android:id="@+id/state"
                layout="@layout/view_state" />

            <Button
                android:id="@+id/btnMoreJobs"
                style="@style/Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/gutter"
                android:layout_marginTop="4dp"
                android:text="@string/see_all"
                android:visibility="gone"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
