<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="12dp">

        <View
            android:id="@+id/bar1"
            android:layout_width="44dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/brand_700" />

        <View
            android:id="@+id/bar2"
            android:layout_width="44dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/line" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/skip"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/jakarta_700"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/skip"
            android:textColor="@color/text_2"
            android:textSize="14sp" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- Step 1: qualification -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxWidth="560dp"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_round18"
                    android:backgroundTint="@color/purple"
                    android:importantForAccessibility="no"
                    android:padding="15dp"
                    android:src="@drawable/ic_school"
                    app:tint="@color/on_brand" />

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/step_1"
                    android:textColor="@color/purple" />

                <TextView
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/q_title" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/q_title_hi"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/q_body" />

                <GridLayout
                    android:id="@+id/qualGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-5dp"
                    android:layout_marginTop="16dp"
                    android:columnCount="2" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 2: state -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_round18"
                    android:backgroundTint="@color/accent"
                    android:importantForAccessibility="no"
                    android:padding="15dp"
                    android:src="@drawable/ic_location_on"
                    app:tint="@color/on_brand" />

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/step_2"
                    android:textColor="@color/accent_text" />

                <TextView
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/s_title" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/s_title_hi"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/select_state"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/DropdownField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:startIconDrawable="@drawable/ic_location_on">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/stateDropdown"
                        style="@style/Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/select_state"
                        android:fontFamily="@font/jakarta_700"
                        android:hint="@string/select_state"
                        android:inputType="none"
                        android:minHeight="54dp"
                        android:textColor="@color/brand_700"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <Button
        android:id="@+id/next"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="20dp"
        android:text="@string/continue_btn"
        app:icon="@drawable/ic_arrow_forward" />
</LinearLayout>
