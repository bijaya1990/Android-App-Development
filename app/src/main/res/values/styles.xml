<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Text ===== -->
    <style name="Text" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">@font/jakarta_800</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">@font/jakarta_800</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Text.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/jakarta_800</item>
    </style>
    <style name="Text.CardTitle">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:fontFamily">@font/jakarta_700</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>
    <style name="Text.Secondary">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_2</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:fontFamily">@font/jakarta_600</item>
    </style>
    <style name="Text.Overline">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:fontFamily">@font/jakarta_800</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Text.Link">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/link</item>
        <item name="android:fontFamily">@font/jakarta_700</item>
    </style>
    <style name="Text.OnBrand">
        <item name="android:textColor">@color/on_brand</item>
    </style>

    <!-- Small rounded info chip (location, posts, qualification). -->
    <style name="MetaChip" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_round8</item>
        <item name="android:backgroundTint">@color/surface_alt</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/jakarta_600</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="drawableTint">@color/text_2</item>
    </style>

    <!-- Days-left pill. Colours are set in code from the deadline. -->
    <style name="DeadlineBadge" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:fontFamily">@font/jakarta_700</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/jakarta_700</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_700</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="iconTint">@color/on_brand</item>
        <item name="iconGravity">textEnd</item>
    </style>

    <style name="Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/jakarta_700</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/brand_100</item>
        <item name="android:textColor">@color/brand_700</item>
        <item name="iconTint">@color/brand_700</item>
    </style>

    <!-- Square icon button in the sticky action bar. -->
    <style name="Button.Square" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:minWidth">52dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_100</item>
        <item name="iconTint">@color/brand_700</item>
    </style>

    <style name="FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/jakarta_700</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipIconTint">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">true</item>
        <item name="chipMinHeight">38dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/NavText</item>
        <item name="itemTextAppearanceInactive">@style/NavText</item>
    </style>
    <style name="NavRail" parent="Widget.Material3.NavigationRailView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/NavText</item>
        <item name="itemTextAppearanceInactive">@style/NavText</item>
    </style>
    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_100</item>
    </style>
    <style name="NavText" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/jakarta_700</item>
        <item name="android:fontFamily">@font/jakarta_700</item>
    </style>

    <style name="DropdownField" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/brand_50</item>
        <item name="boxStrokeColor">@color/brand_700</item>
        <item name="startIconTint">@color/accent</item>
        <item name="endIconTint">@color/brand_700</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- Home header stats -->
    <style name="StatBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
    <style name="StatValue" parent="Text.OnBrand">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/jakarta_800</item>
        <item name="android:textSize">17sp</item>
        <item name="android:text">–</item>
    </style>
    <style name="StatLabel" parent="Text.OnBrand">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:alpha">0.85</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/gutter</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="GlassIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:tint">@color/on_brand</item>
        <item name="android:scaleType">center</item>
    </style>
    <style name="CardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="CardHeading" parent="Text.Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">15.5sp</item>
    </style>

    <style name="MoreSection" parent="Text.Overline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/gutter</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

</resources>
