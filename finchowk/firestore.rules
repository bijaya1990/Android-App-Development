rules_version = '2';

// Full rule set is implemented + unit-tested in Phase 6 (Hardening).
// Source of truth for the target shape: FinChowk Claude Code Prompt, section 5.3.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /clicks/{autoId} {
      allow create: if request.resource.data.keys().hasOnly(['offerId', 'partnerId', 'category', 'ts', 'appVersion'])
                    && request.resource.data.ts == request.time;
      allow read, update, delete: if false; // app can never read clicks
    }

    match /stats/{doc=**} {
      allow read: if isAdmin();
      allow write: if false; // stats written only by Cloud Functions (admin SDK)
    }

    match /conversions/{doc=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLog/{doc=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
