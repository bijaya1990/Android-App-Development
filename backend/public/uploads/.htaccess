# Uploaded files are user-supplied. Never let this directory execute
# scripts, no matter what extension a file ends up with.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI -Indexes
AddHandler cgi-script .php .php3 .php4 .php5 .php7 .phtml .pl .py .cgi .sh
